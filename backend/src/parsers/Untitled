import fs from 'fs';
import path from 'path';
import OpenAI from 'openai';

const INSTRUCTIONS = `Extract all bank transactions from this PDF. Return strictly valid JSON only, with no other text or markdown. Use exactly this structure:
{
  "rows": [
    {
      "date": "YYYY-MM-DD",
      "description": "string",
      "amount": number,
      "balance": number | null
    }
  ]
}
- date: ISO date YYYY-MM-DD for each transaction.
- description: transaction description text.
- amount: signed number (positive = money in, negative = money out).
- balance: running balance if present, otherwise null.`;

export type PdfTransactionRow = {
  date: string;
  description: string;
  amount: number;
  balance: number | null;
};

export type ParsePdfResult = {
  rows: PdfTransactionRow[];
  errors: string[];
  warnings: string[];
};

export async function parsePdfFile(filePath: string): Promise<ParsePdfResult> {
  const errors: string[] = [];
  const warnings: string[] = [];

  if (!process.env.OPENAI_API_KEY) {
    return { rows: [], errors: ['OPENAI_API_KEY not set'], warnings };
  }

  try {
    const buffer = fs.readFileSync(filePath);
    const base64 = buffer.toString('base64');
    const filename = path.basename(filePath);

    const client = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });

    const response = await client.responses.create({
      model: 'gpt-4.1',
      input: [
        {
          role: 'user',
          content: [
            {
              type: 'input_file',
              filename,
              file_data: `data:application/pdf;base64,${base64}`,
            },
            {
              type: 'input_text',
              text: INSTRUCTIONS,
            },
          ],
        },
      ],
    });

    const text = (response as any).output_text ?? '';
    const start = text.indexOf('{');
    const end = text.lastIndexOf('}');
    if (start === -1 || end === -1) {
      return { rows: [], errors: ['Model did not return JSON'], warnings };
    }

    const json = JSON.parse(text.slice(start, end + 1));
    const rows = Array.isArray(json.rows) ? json.rows : [];

    return { rows, errors, warnings };
  } catch (err: any) {
    return { rows: [], errors: [err.message ?? 'Unknown error'], warnings };
  }
}
